# Compose config: cp .env.example .env, fill the two Supabase values, then `docker compose up`.
# Supabase project URL (dashboard -> Project Settings -> API). Empty = placeholder mode: app runs, auth says "not configured".
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) API key — NOT the service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# API origin AS THE BROWSER SEES IT (host-reachable; never http://api:8000 — see docker-compose.yml).
NEXT_PUBLIC_API_URL=http://localhost:8000
# true = deterministic mock predictions; set false once the trained model lands in api/predict/model.py.
MOCK_MODE=true
# Comma-separated browser origins the API accepts (add the university server origin when deploying).
CORS_ORIGINS=http://localhost:3000

# VPS production (docker-compose.prod.yml) only: the two public hostnames.
# Their DNS A records must point at the VPS; Caddy fetches TLS automatically.
DOMAIN_WEB=project.example.com
DOMAIN_API=api.example.com
