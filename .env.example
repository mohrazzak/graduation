# Compose config: cp .env.example .env, fill the two Supabase values, then `docker compose up`.
# Supabase project URL (dashboard -> Project Settings -> API). Empty = placeholder mode: app runs, auth says "not configured".
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) API key — NOT the service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# API origin AS THE BROWSER SEES IT (host-reachable; never http://api:8000 — see docker-compose.yml).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Which classifiers the model picker offers, comma-separated, in roster order.
# Defaults to mock in compose because the real backends need heavy deps + weight
# files that are not in the image. Locally, with requirements-models.txt
# installed, use: resnet50-phinet,yolo-cls,raed
# To show ONLY Raed's model: ENABLED_MODELS=raed
ENABLED_MODELS=mock
# Absolute paths to the trained weights. Leave empty to mark a model unavailable
# (the picker then shows it disabled, with a reason, rather than hiding it).
RESNET_WEIGHTS_PATH=
YOLO_WEIGHTS_PATH=
YOLO_ACCURACY_PATH=
RAED_WEIGHTS_PATH=

# --- Generation services (optional) -------------------------------------
# 2D restoration. Free tier includes a small daily image quota; when it is spent
# the job still returns the locally-computed mask and edge map and says so.
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=
# 3D reconstruction. Needs account credit; a zero balance is reported as
# "out of credit" rather than a failure. https://platform.tripo3d.ai
TRIPO_API_KEY=
# Comma-separated browser origins the API accepts (add the university server origin when deploying).
CORS_ORIGINS=http://localhost:3000

# VPS production (docker-compose.prod.yml) only: the two public hostnames.
# Their DNS A records must point at the VPS; Caddy fetches TLS automatically.
DOMAIN_WEB=project.example.com
DOMAIN_API=api.example.com
