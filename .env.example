# Compose config: cp .env.example .env, fill the two Supabase values, then `docker compose up`.
# Supabase project URL (dashboard -> Project Settings -> API). Empty = placeholder mode: app runs, auth says "not configured".
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) API key — NOT the service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# API origin AS THE BROWSER SEES IT (host-reachable; never http://api:8000 — see docker-compose.yml).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Active roster. The product serves one trained detector; compose defaults to
# the deterministic mock because the weights are not in the image.
ENABLED_MODELS=mock
# Weights for the trained detector. Lives OUTSIDE the repo; set this where the
# checkpoint is mounted and switch ENABLED_MODELS to raed.
RAED_WEIGHTS_PATH=
# Minimum detection confidence. An image with no box above this threshold
# returns `no_detection`; it is never silently labeled No Damage.
RAED_CONFIDENCE_THRESHOLD=0.25

# --- Generation services (optional) -------------------------------------
# 2D restoration. Free tier includes a small daily image quota; when it is spent
# the job still returns the locally-computed mask and edge map and says so.
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=
# Repair backend: auto prefers a ready local ControlNet worker, then Gemini;
# set local-controlnet to require the local worker, or gemini to require Gemini.
REPAIR_BACKEND=auto
# Absolute Python executable for the isolated local ControlNet environment.
# The default is api/.venv-repair/bin/python.
LOCAL_REPAIR_PYTHON=
# Worker time limit in seconds (30-3600; default 900).
LOCAL_REPAIR_TIMEOUT_SECONDS=900
# 3D reconstruction. Needs account credit; a zero balance is reported as
# "out of credit" rather than a failure. https://platform.tripo3d.ai
TRIPO_API_KEY=
# Comma-separated browser origins the API accepts (add the university server origin when deploying).
CORS_ORIGINS=http://localhost:3000

# VPS production (docker-compose.prod.yml) only: the two public hostnames.
# Their DNS A records must point at the VPS; Caddy fetches TLS automatically.
DOMAIN_WEB=project.example.com
DOMAIN_API=api.example.com
