# Copy to web/.env.local and fill in. All three are public client-side values.
# Supabase project URL (dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) API key — NOT the service_role key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# FastAPI base URL (mock prediction backend)
NEXT_PUBLIC_API_URL=http://localhost:8000
